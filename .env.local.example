# Copy to .env.local for local dev, and set the same keys in your
# hosting provider's dashboard (e.g. Vercel > Project > Settings >
# Environment Variables) for production.
#
# Until NEXT_PUBLIC_SUPABASE_URL / NEXT_PUBLIC_SUPABASE_ANON_KEY are set,
# the app runs standalone against localStorage — nothing below is
# required to try it locally.

# --- Public (safe to expose to the browser) --------------------------
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server-only secrets — NEVER prefix these with NEXT_PUBLIC_ -------
# Supabase Dashboard -> Project Settings -> API -> service_role key.
# Used only in server-side API routes (src/app/api/**) for operations
# that must bypass RLS, such as the scheduled-publish cron job.
SUPABASE_SERVICE_ROLE_KEY=

# Random string of your choosing. Sent as `Authorization: Bearer <value>`
# by Vercel Cron to /api/cron/publish-scheduled so the endpoint can't be
# triggered by anyone else. Generate one with: openssl rand -hex 32
CRON_SECRET=
